{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.epheterson/applemusic-mcp",
  "description": "Apple Music MCP server: playlists, library, catalog, playback and Up Next, on Mac/Windows/Linux.",
  "repository": {
    "url": "https://github.com/epheterson/applemusic-mcp",
    "source": "github"
  },
  "version": "0.18.5",
  "packages": [
    {
      "registryType": "pypi",
      "identifier": "applemusic-mcp",
      "version": "0.18.5",
      "transport": {
        "type": "stdio"
      },
      "runtimeHint": "uvx",
      "packageArguments": [
        {
          "type": "positional",
          "value": "serve"
        }
      ]
    }
  ]
}
